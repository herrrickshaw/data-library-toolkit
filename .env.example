# Copy to .env and edit, or export these directly.

# Where the catalog DB, converted markdown, and staging scratch space live.
DLT_DATA_DIR=./data

# Comma-separated rclone remote prefixes to discover/fetch from.
# `rclone config` first to set these up. Example: "dropbox:,gdrive:"
DLT_RCLONE_REMOTES=dropbox:

# Where converted files get copied back to under each source remote.
# Set to empty to disable cloud copy-back entirely.
DLT_CLOUD_DEST_FOLDER=dlt_md_corpus

# Comma-separated top-level folder names (case-insensitive) to skip during
# discovery — huge machine-backup trees, a tool's own per-item storage
# mirror, etc. Optional.
DLT_SKIP_FOLDERS=

# Zotero local API (Zotero desktop app running, with Settings -> Advanced ->
# "Allow other applications on this computer to communicate with Zotero"
# enabled). Leave DLT_ZOTERO_LOCAL=1 for this; set to 0 and provide
# DLT_ZOTERO_API_KEY + a real library id for the Zotero web API instead.
DLT_ZOTERO_LOCAL=1
DLT_ZOTERO_LIBRARY_ID=0
DLT_ZOTERO_LIBRARY_TYPE=user
# DLT_ZOTERO_API_KEY=

# Tuning (defaults are sane for a personal cloud account).
DLT_MAX_DOCS_PER_RUN=1000
DLT_MAX_SINGLE_FILE_MB=300
DLT_DISK_SAFETY_MARGIN_GB=5
